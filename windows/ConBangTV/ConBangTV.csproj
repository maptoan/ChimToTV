<Project Sdk="Microsoft.NET.Sdk">

  <!-- MTV cho Windows: WPF + WebView2 (nhân Chromium như WebView của bản Android). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ConBangTV</RootNamespace>
    <AssemblyName>MTV</AssemblyName>
    <Product>MTV</Product>
    <Company>MTV</Company>
    <Description>MTV</Description>
    <Copyright>MTV</Copyright>
    <!-- Số hiệu bản Windows (tag win-v<bản>) -->
    <Version>1.22.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>vi</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
  </ItemGroup>

  <!-- Dùng chung tệp của bản Android (một nguồn duy nhất để sửa) -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\app\src\main\assets\player-agent.js" LogicalName="player-agent.js" />
    <EmbeddedResource Include="..\..\app\src\main\assets\page-focus.js" LogicalName="page-focus.js" />
    <EmbeddedResource Include="..\..\app\src\main\assets\player.html" LogicalName="player.html" />
    <EmbeddedResource Include="..\..\app\src\main\assets\hls.html" LogicalName="hls.html" />
    <EmbeddedResource Include="..\..\app\src\main\assets\hls.light.min.js" LogicalName="hls.light.min.js" />
    <!-- Bản hls.js đầy đủ (luồng âm thanh tách rời) — chỉ cho Video.Hls (dexter.pw) -->
    <EmbeddedResource Include="..\..\app\src\main\assets\hls.min.js" LogicalName="hls.min.js" />
    <EmbeddedResource Include="..\..\app\src\main\assets\web-fetch.js" LogicalName="web-fetch.js" />
    <Resource Include="logo.png" />
    <Resource Include="app.ico" />
  </ItemGroup>

  <!-- Lõi Rust dùng chung với bản Linux (Core/Native.cs): crate conbang-ffi trong linux\ffi, dựng bản release bằng cargo
       (build.ps1 tự dựng). Đóng gói một tệp: nằm trong .exe, .NET tự giải nén lúc chạy (IncludeNativeLibrariesForSelfExtract). -->
  <ItemGroup>
    <None Include="..\..\linux\target\release\conbang_core.dll" Link="conbang_core.dll" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\..\linux\target\release\conbang_core.dll')" />
  </ItemGroup>

  <!-- Trình phát native (Player/NativeVideo.cs): libmpv-2.dll — build.ps1 tải bản dựng của shinchiro/mpv-winbuild-cmake (đúng
       SHA-256) vào windows\vendor\mpv. Không có thì app phát bằng WebView2 như trước. -->
  <ItemGroup>
    <None Include="..\vendor\mpv\x\libmpv-2.dll" Link="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\vendor\mpv\x\libmpv-2.dll')" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ConBangTV.Tests" />
  </ItemGroup>

</Project>
